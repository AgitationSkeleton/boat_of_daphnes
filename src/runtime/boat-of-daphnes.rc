// The program's icon (a render of the King of Red Lions, assets/icon) and version information.
#include <winver.h>

1 ICON "../../assets/icon/boat-of-daphnes.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Boat of Daphnes (The Wind Waker static recompilation)"
            VALUE "ProductName", "Boat of Daphnes"
            VALUE "FileVersion", "0.1"
            VALUE "ProductVersion", "0.1"
            VALUE "LegalCopyright", "GPL-3.0-or-later; game code is the player's own"
            VALUE "OriginalFilename", "boat-of-daphnes.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
