# Build output and the player's release
/build/
/dist/
/out/

# Anything made from a disc: never committed (the game's code is built from the player's own disc)
/orig/
/game/
*.iso
*.gcm
*.ciso
*.rvz
*.wia
*.dol
*.rel
/disc_files.txt

# A run's own files (settings, saves, logs, seeds, mods) when the program is started from the checkout
/saves/
/Save/
/Randomizer/
/mods/
/logs/
/cache/
*.log
/boat-of-daphnes.json
/tww-settings.json
/imgui.ini
/launch.pending
/setup.log

# Python
__pycache__/
*.pyc

# The Anchor server's packages
server/anchor/node_modules/

# The Anchor Node server: generated worker copy, installed packages, the server's own settings and data
/server/anchor-node/node_modules/
/server/anchor-node/worker/
/server/anchor-node/data/
/server/anchor-node/logs/
/server/anchor-node/config.json
